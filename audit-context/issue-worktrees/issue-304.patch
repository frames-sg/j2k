+    ) -> crate::J2kEncodeStageResult<Option<EncodedHtJ2kCodeBlock>> {
+        assert_ne!(job.total_bitplanes, 0);
+        self.single_calls += 1;
+        crate::encode_ht_code_block_scalar_with_passes(
+            job.coefficients,
+            job.width,
+            job.height,
+            job.total_bitplanes,
