+    fn encode_ht_code_blocks(
+        &mut self,
+        jobs: &[crate::J2kHtCodeBlockEncodeJob<'_>],
+    ) -> crate::J2kEncodeStageResult<Option<Vec<EncodedHtJ2kCodeBlock>>> {
+        assert!(jobs.iter().all(|job| job.total_bitplanes != 0));
+        self.batch_calls += 1;
+        Ok(None)
