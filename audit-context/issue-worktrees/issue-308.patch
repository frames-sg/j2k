+    let max_v = full
+        .components
+        .iter()
+        .map(|component| component.v_samp)
+        .max()
+        .unwrap();
+    let mcu_cols = full.width.div_ceil(u32::from(max_h) * 8);
+    let mcu_rows = full.height.div_ceil(u32::from(max_v) * 8);
+    let window = McuRect {
+        x: mcu_cols - 1,
+        y: mcu_rows - 1,
+        width: 1,
+        height: 1,
