+#[derive(Clone, Copy)]
+pub(crate) struct JpegBaselineFrameMetadata<'a> {
+    pub(crate) sampling: JpegBaselineSampling,
+    pub(crate) component_ids: &'a [u8],
+    pub(crate) component_quant: &'a [[u8; 64]],
+    pub(crate) app_segments: &'a [u8],
+}
+
+pub(crate) fn assemble_jpeg_baseline_frame_with_metadata(
+    entropy: &[u8],
+    width: u32,
+    height: u32,
+    metadata: JpegBaselineFrameMetadata<'_>,
+    backend: JpegBackend,
+) -> Result<EncodedJpeg, JpegEncodeError> {
+    let JpegBaselineFrameMetadata {
+        sampling,
+        component_ids,
+        component_quant,
+        app_segments,
+    } = metadata;
+    validate_jpeg_baseline_dimensions(width, height)?;
+    validate_app_segments(app_segments)?;
+    if component_ids.len() != usize::from(sampling.components)
+        || component_quant.len() != usize::from(sampling.components)
+    {
+        return Err(JpegEncodeError::InvalidDctImage {
+            reason: JpegDctImageError::InvalidMetadata {
+                reason: "DCT frame metadata does not match component count",
+            },
+        });
+    }
+    for (index, id) in component_ids.iter().enumerate() {
+        if component_ids[..index].contains(id) {
+            return Err(JpegEncodeError::InvalidDctImage {
+                reason: JpegDctImageError::InvalidMetadata {
+                    reason: "DCT frame component identifiers must be unique",
+                },
+            });
+        }
+    }
+
+    let extra = app_segments
+        .len()
+        .checked_add(component_quant.len().saturating_mul(65))
+        .ok_or(JpegEncodeError::HostAllocationFailed { bytes: usize::MAX })?;
+    let capacity = checked_jpeg_baseline_frame_capacity(
+        entropy
+            .len()
+            .checked_add(extra)
+            .ok_or(JpegEncodeError::HostAllocationFailed { bytes: usize::MAX })?,
+    )?;
+    let mut out = CappedBytes::try_with_capacity(capacity, capacity)?;
+    write_marker(&mut out, 0xD8)?;
+    out.extend_from_slice(app_segments)?;
+
+    let mut unique_quant = [[0u8; 64]; 3];
+    let mut unique_quant_count = 0usize;
+    let mut quant_ids = [0u8; 3];
+    for (index, table) in component_quant.iter().enumerate() {
+        let slot = unique_quant[..unique_quant_count]
+            .iter()
+            .position(|existing| existing == table);
+        let slot = slot.unwrap_or_else(|| {
+            let slot = unique_quant_count;
+            unique_quant[slot] = *table;
+            unique_quant_count += 1;
+            slot
+        });
+        quant_ids[index] = u8::try_from(slot).map_err(|_| JpegEncodeError::InternalInvariant {
+            reason: "DCT quantization table identifier exceeds u8",
+        })?;
+    }
+    for (id, table) in unique_quant[..unique_quant_count].iter().enumerate() {
+        write_dqt(
+            &mut out,
+            u8::try_from(id).map_err(|_| JpegEncodeError::InternalInvariant {
+                reason: "DCT quantization table identifier exceeds u8",
+            })?,
+            table,
+        )?;
+    }
+    write_sof0_with_metadata(&mut out, width, height, sampling, component_ids, quant_ids)?;
+    write_dht(&mut out, 0, 0, &STD_LUMA_DC_BITS, &STD_LUMA_DC_VALUES)?;
+    write_dht(&mut out, 1, 0, &STD_LUMA_AC_BITS, &STD_LUMA_AC_VALUES)?;
+    if sampling.components == 3 {
+        write_dht(&mut out, 0, 1, &STD_CHROMA_DC_BITS, &STD_CHROMA_DC_VALUES)?;
+        write_dht(&mut out, 1, 1, &STD_CHROMA_AC_BITS, &STD_CHROMA_AC_VALUES)?;
+    }
+    write_sos_with_ids(&mut out, component_ids)?;
+    out.extend_from_slice(entropy)?;
+    write_marker(&mut out, 0xD9)?;
+    Ok(EncodedJpeg {
+        data: out.into_vec(),
+        backend,
+    })
+}
+
+fn validate_app_segments(segments: &[u8]) -> Result<(), JpegEncodeError> {
+    let mut offset = 0usize;
+    while offset < segments.len() {
+        let marker = *segments.get(offset).unwrap_or(&0);
+        let kind = *segments.get(offset + 1).unwrap_or(&0);
+        let length = segments
+            .get(offset + 2..offset + 4)
+            .and_then(|bytes| <[u8; 2]>::try_from(bytes).ok())
+            .map(u16::from_be_bytes)
+            .map(usize::from);
+        let Some(end) = length
+            .filter(|length| *length >= 2)
+            .and_then(|length| offset.checked_add(length + 2))
+        else {
+            return Err(JpegEncodeError::InvalidDctImage {
+                reason: JpegDctImageError::InvalidMetadata {
+                    reason: "DCT frame APP marker is truncated",
+                },
+            });
+        };
+        if marker != 0xff || !(0xe0..=0xef).contains(&kind) || end > segments.len() {
+            return Err(JpegEncodeError::InvalidDctImage {
+                reason: JpegDctImageError::InvalidMetadata {
+                    reason: "DCT frame metadata must contain complete APP markers only",
+                },
+            });
+        }
+        offset = end;
+    }
+    Ok(())
+}
+
+fn write_sof0_with_metadata(
+    out: &mut CappedBytes,
+    width: u32,
+    height: u32,
+    sampling: JpegBaselineSampling,
+    component_ids: &[u8],
+    quant_ids: [u8; 3],
+) -> Result<(), JpegEncodeError> {
+    let height =
+        u16::try_from(height).map_err(|_| JpegEncodeError::DimensionsTooLarge { width, height })?;
+    let width = u16::try_from(width).map_err(|_| JpegEncodeError::DimensionsTooLarge {
+        width,
+        height: u32::from(height),
+    })?;
+    write_segment_header(out, 0xC0, 6 + component_ids.len() * 3, "SOF0")?;
+    out.push(8)?;
+    out.extend_from_slice(&height.to_be_bytes())?;
+    out.extend_from_slice(&width.to_be_bytes())?;
+    out.push(sampling.components)?;
+    for (index, &id) in component_ids.iter().enumerate() {
+        out.push(id)?;
+        out.push((sampling.h[index] << 4) | sampling.v[index])?;
+        out.push(quant_ids[index])?;
+    }
+    Ok(())
+}
+
+fn write_sos_with_ids(out: &mut CappedBytes, component_ids: &[u8]) -> Result<(), JpegEncodeError> {
+    write_segment_header(out, 0xDA, 4 + component_ids.len() * 2, "SOS")?;
+    out.push(u8::try_from(component_ids.len()).map_err(|_| {
+        JpegEncodeError::InternalInvariant {
+            reason: "DCT frame component count exceeds u8",
+        }
+    })?)?;
+    for (index, &id) in component_ids.iter().enumerate() {
+        out.push(id)?;
+        out.push(if index == 0 { 0x00 } else { 0x11 })?;
+    }
+    out.extend_from_slice(&[0, 63, 0])
+}
+
 fn write_dqt(out: &mut CappedBytes, table_id: u8, quant: &[u8; 64]) -> Result<(), JpegEncodeError> {
     write_segment_header(out, 0xDB, 65, "DQT")?;
     out.push(table_id)?;
